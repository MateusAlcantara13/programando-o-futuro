# Anthropic
ANTHROPIC_API_KEY=sua-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-4-5

# Banco de dados MySQL
# Os valores abaixo já combinam com o MySQL local do docker-compose.yml
# da raiz do projeto. Em produção (Aiven), troque host/usuário/senha/nome
# pelos dados reais.
DB_HOST=localhost
DB_PORT=3306
DB_USER=programando
DB_PASSWORD=programando_local
DB_NAME=programando_futuro

# TLS da conexão com o banco é obrigatório por padrão: se DB_SSL_CA não
# apontar para um certificado válido, a conexão falha, em vez de seguir
# sem TLS. DB_SSL_DISABLED=true desliga essa exigência e deve ser usado
# SOMENTE com o MySQL local do docker-compose.yml. Nunca defina isso em
# produção.
DB_SSL_DISABLED=true
# Caminho do certificado da CA, só é lido quando DB_SSL_DISABLED não é
# "true". Em produção aponta para o certificado da Aiven.
DB_SSL_CA=backend/ca.pem

# Autenticação
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_H=24
ADMIN_SECRET=troque-por-um-valor-aleatorio-longo

# Limite de chamadas simultâneas à API da Anthropic. Jobs além desse
# número esperam a vez em vez de serem todos disparados de uma vez.
IA_MAX_CONCORRENTES=5
