# Onde a aplicação está rodando. Obrigatória, sem valor padrão.
#   local    = máquina de desenvolvimento, com o banco do docker-compose.yml
#   producao = servidor publicado (Render)
# Com AMBIENTE=producao a aplicação se recusa a iniciar se IA_SIMULADA
# ou DB_SSL_DISABLED estiverem ligados.
AMBIENTE=local

# Anthropic
ANTHROPIC_API_KEY=sua-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-4-5

# Banco de dados MySQL
# Os valores abaixo já combinam com o MySQL local do docker-compose.yml
# da raiz do projeto. Em produção (Aiven), troque host/usuário/senha/nome
# pelos dados reais.
DB_HOST=localhost
DB_PORT=3306
DB_USER=programando
DB_PASSWORD=programando_local
DB_NAME=programando_futuro

# TLS da conexão com o banco é obrigatório por padrão: se DB_SSL_CA não
# apontar para um certificado válido, a conexão falha, em vez de seguir
# sem TLS. Depois de conectar, a aplicação também pergunta ao servidor
# se a conexão está cifrada (Ssl_cipher) e não inicia se não estiver.
# DB_SSL_DISABLED=true desliga essa exigência e deve ser usado
# SOMENTE com o MySQL local do docker-compose.yml. Com AMBIENTE=producao
# a aplicação se recusa a iniciar se isto estiver ligado.
DB_SSL_DISABLED=true
# Caminho do certificado da CA, só é lido quando DB_SSL_DISABLED não é
# "true". Em produção aponta para o certificado do provedor do banco.
# Caminho relativo é lido a partir da raiz do repositório, não da pasta
# de onde o backend foi iniciado. Caminho absoluto também funciona. Sem
# a variável, vale backend/ca.pem.
DB_SSL_CA=backend/ca.pem

# Autenticação
# JWT_SECRET assina os tokens de login. Obrigatória: sem ela a aplicação
# não inicia. Quem tem esse valor consegue gerar token de qualquer
# usuário, então use um valor aleatório e longo, diferente em cada
# ambiente. Para gerar um:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_H=24
# ADMIN_SECRET é a senha do painel administrativo (rotas /api/admin/*).
# Obrigatória: sem ela a aplicação não inicia. A senha usada até
# outubro de 2026 está no histórico público do repositório e não pode
# ser reaproveitada. Gere uma nova do mesmo jeito que o JWT_SECRET.
ADMIN_SECRET=troque-por-um-valor-aleatorio-longo

# Limite de chamadas simultâneas à API da Anthropic. Jobs além desse
# número esperam a vez em vez de serem todos disparados de uma vez.
IA_MAX_CONCORRENTES=5

# ATENÇÃO: estas variáveis existem só para testar carga e para os
# testes automatizados. Com IA_SIMULADA=true nenhuma chamada real
# à IA acontece e todo plano gerado é falso, marcado com
# [SIMULADO]. Com AMBIENTE=producao a aplicação se recusa a iniciar se
# isto estiver ligado.
#
# Só o valor "true" liga o modo. Valor inválido em qualquer uma delas
# impede a aplicação de iniciar. Detalhes em backend/ia_simulada.py.
#
# IA_SIMULADA=false
# Espera sorteada por tentativa, em segundos (min,max). Os padrões vêm
# de três medições locais sem concorrência, em 01/11/2026.
# IA_SIMULADA_ESPERA=93.6,100.8
# IA_SIMULADA_ESPERA_LISTA=18.6,23.0
# Probabilidade de cada tentativa falhar, de 0 a 1. Com 1, toda
# tentativa falha e o job chega a 3 tentativas.
# IA_SIMULADA_FALHA=0
# Tipo da falha: 529 | 429 | timeout | conexao | json
# IA_SIMULADA_TIPO_FALHA=529
